# Domain Hub 服务配置（复制到 .env 后填入真实值；请勿提交 .env 到 Git）
DOMAIN_HUB_URL=https://hub.llmhubone.net
# 方案 A（匿名 /v1/intake）可留空；方案 B（授权节点上传 / 队列任务 / 搜索取数）必填
DOMAIN_HUB_TOKEN=

# 可选：单线程 Linux 代理（默认直连，不需要多代理池；如内网需要出口才填写）
# WHOIS_SOCKS5_PROXY=socks5://user:pass@host:port
# HTTP_PROXY_URL=http://host:port

# 单线程节奏与超时控制（单位：秒）
WHOIS_RDAP_DELAY_MIN=0.7
WHOIS_RDAP_DELAY_MAX=1.2
WHOIS_CNNIC_DELAY_MIN=1.4
WHOIS_CNNIC_DELAY_MAX=2.2
INTAKE_DELAY_SEC=16.0
HUB_HTTP_TIMEOUT=60

# 可选：OpenAI 兼容联网搜索通道（仅用户自行配置了合规 API 时使用 icp-enrich-llm）
ICP_LLM_API_URL=
ICP_LLM_API_KEY=
ICP_LLM_MODEL=glm-4-flash
